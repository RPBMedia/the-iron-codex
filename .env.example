AUTH_SESSION_SECRET="replace-with-a-long-random-secret"
AUTH_BASE_URL="http://localhost:4000"

# Create a Google OAuth Web client and add:
# http://localhost:4000/api/auth/google/callback
# as an authorized redirect URI for local development.
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# Optional production-only tightening.
# CORS_ORIGIN="https://your-domain.example"
# AUTH_USERS_FILE="/absolute/path/to/users.json"

# ---- User accounts ---------------------------------------------------------
# The server picks a store from the environment, in this order:
#   1. Upstash Redis   (below)          — the deployed configuration
#   2. Supabase        (also supported) — SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
#   3. A local JSON file                — development only; CANNOT work on a
#      read-only/serverless host, where every write fails with EROFS.
#
# Upstash console -> your database -> REST API. Both values are server-only.
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-rest-token"

# Alternative backend, kept supported but unused when Upstash is configured.
# SUPABASE_URL="https://your-project-ref.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# SUPABASE_USERS_TABLE="ironcodex_users"
