{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "server/data/archive/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/characters",
      "destination": "/people",
      "permanent": true
    },
    {
      "source": "/characters/:id",
      "destination": "/people/:id",
      "permanent": true
    },
    {
      "source": "/artifacts/joyeuse",
      "destination": "/weapons-armor/joyeuse",
      "permanent": true
    },
    {
      "source": "/artifacts/sutton-hoo-helmet",
      "destination": "/weapons-armor/sutton-hoo-helmet",
      "permanent": true
    },
    {
      "source": "/locations/teutonic-order",
      "destination": "/orders/teutonic-order",
      "permanent": true
    },
    {
      "source": "/locations/pechenegs",
      "destination": "/civilizations/pechenegs",
      "permanent": true
    },
    {
      "source": "/locations/cumans",
      "destination": "/civilizations/cumans",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/map-data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
